{
  "Word Component": {
    "scope": "mdx, yaml, markdown",
    "prefix": ["<w", "<word", "w", "word"],
    "body": [
      "<Word${1: id=\"${2:value}\"}>$3</Word"
    ],
    "description": "Insert Word component with optional id"
  },
  "InlineImage Component (Name and Alt)": {
    "scope": "mdx, yaml, markdown",
    "prefix": ["<i", "<inline", "<inlineimage", "i", "inline", "inlineimage"],
    "body": [
      "<InlineImage name=\"${1}\" alt=\"${2}\"/"
    ],
    "description": "Insert InlineImage with name and alt"
  },
  "InlineImage Component (Item, Rarity and Alt)": {
    "scope": "mdx, yaml, markdown",
    "prefix": ["<i", "<inline", "<inlineimage", "i", "inline", "inlineimage", "item"],
    "body": [
      "<InlineImage item=\"${1}\" rarity=\"${2}\" alt=\"${3}\"/"
    ],
    "description": "Insert InlineImage with item, rarity and alt"
  },

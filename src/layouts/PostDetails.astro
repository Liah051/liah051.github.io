---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { SIDEBAR_MAP, DefaultSidebar } from "@/components/sidebars";
import Comments from "@/components/Comments.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import Word from "@/components/Word.astro";
import InlineImage from "@/components/InlineImage.astro";
import AspaChip from "@/components/ASPA/AspaChip.astro";
import PostFooterStack from "@/components/PostFooterStack.astro";

import Physics from "@/components/Physics.astro";
import AspaCharSheet from "@/components/ASPA/AspaCharSheet.astro";
import Tabs from "@/components/Tabs.astro";
import Text from "@/components/Text.astro";

// ... [既存のインポートを維持、手動でマージするのではなくインポート部分全体を編集すると長くなるので、最初の方に追加します]
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  category_id,
} = post.data;

const { Content, headings } = await render(post);

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const SelectedSidebar = (category_id && SIDEBAR_MAP[category_id]) || DefaultSidebar;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header category_id={category_id} isPost={true} headings={headings} />
  <BackButton backUrl={category_id && category_id !== "other" ? `/toppages/${category_id}` : undefined} backText={category_id && category_id !== "other" ? "< トップに戻る" : undefined} />
  <main
    id="main-content"
    class:list={["app-layout pb-12", { "mt-8": !SITE.showBackButton }]}
    data-pagefind-body
  >

    <div class="flex flex-col md:flex-row md:justify-between items-start md:items-stretch gap-18 lg:gap-24">
      <!-- Left Column: Main Content -->
      <div class="w-full min-w-0 md:max-w-[780px] lg:max-w-[800px] md:translate-x-0 relative z-10">

        <h1
          transition:name={slugifyStr(title.replaceAll(".", "-"))}
          class="inline-block text-2xl font-bold text-accent sm:text-3xl"
        >
          {title}
        </h1>
        <div class="my-2 flex items-center gap-2">
          <Datetime pubDatetime={pubDatetime} modDatetime={modDatetime} timezone={timezone} size="lg" />

          <span
            aria-hidden="true"
            class:list={[
              "max-sm:hidden",
              { hidden: !SITE.editPost.enabled || hideEditPost },
            ]}>|</span
          >
          <EditPost hideEditPost={hideEditPost} post={post} class="max-sm:hidden" />

        </div>

        <div class="mt-8">
          <TableOfContents headings={headings} mode="collapsible" />
        </div>

        <article
          id="article"
          class="app-prose w-full prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
        >
          <Content components={{ Word, InlineImage, AspaChip, Physics, AspaCharSheet, Tabs, Text }} />

        </article>

        <hr class="my-8 border-dashed" />

        <EditPost class="sm:hidden" hideEditPost={hideEditPost} post={post} />



        <PostFooterStack post={post} posts={posts} />

        <ul class="mt-8 mb-8 flex flex-wrap gap-4 sm:my-8">
          {
            tags.map(tag => (
              <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
            ))
          }
        </ul>

        <BackToTopButton />

        <ShareLinks />

        <hr class="my-6 border-dashed" />

        <Comments id={post.id} title={title} url={Astro.url.href} />

      </div>

      <!-- Right Column: Sidebar -->
      <aside
        class="hidden md:flex w-full flex-col gap-6 pb-8 md:order-last md:pb-0 md:w-[252px] lg:w-[270px] shrink-0"

      >
        <SelectedSidebar />

        <!-- Table of Contents -->
        <TableOfContents headings={headings} mode="sticky" />
      </aside>
    </div>

  </main>
  <Footer />
</Layout>

<script is:inline data-astro-rerun>
  /** Create a progress indicator at the top */
  function setupProgressBar() {
    // Check if progress bar already exists to avoid duplicates
    if (document.querySelector(".progress-container")) return;

    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-[60] h-1 w-full bg-background";

    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    progressContainer.appendChild(progressBar);
    document.body.appendChild(progressContainer);
    
    // Use a single listener for scroll updates
    window.addEventListener("scroll", () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      const myBar = document.getElementById("myBar");
      if (myBar) {
        myBar.style.width = scrolled + "%";
      }
    }, { passive: true });
  }

  /** Attaches links to headings */
  function addHeadingLinks() {
    const headings = document.querySelectorAll("h2[id], h3[id], h4[id], h5[id], h6[id]");
    for (const heading of headings) {
      if (heading.querySelector(".heading-link")) continue;
      
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;
      const text = heading.textContent?.replace(/#/g, "").trim() || "";
      link.setAttribute("aria-label", text ? `「${text}」へのリンク` : "セクションへのリンク");

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }

  /** Copy buttons for code blocks */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      if (codeBlock.querySelector(".copy-code")) continue;

      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      const topClass = hasFileNameOffset ? "top-(--file-name-offset)" : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium transition-all hover:bg-muted/80`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      if (codeBlock.parentNode) {
        codeBlock.parentNode.insertBefore(wrapper, codeBlock);
        wrapper.appendChild(codeBlock);
      }

      copyButton.addEventListener("click", async () => {
        const code = codeBlock.querySelector("code");
        const text = code?.innerText || "";
        try {
          await navigator.clipboard.writeText(text);
          copyButton.innerText = "Copied";
          setTimeout(() => { copyButton.innerText = copyButtonLabel; }, 700);
        } catch (err) {
          console.error("Failed to copy:", err);
        }
      });
    }
  }

  /** Image Lightbox Modal */
  function setupLightbox() {
    let lightboxModal = document.getElementById("lightbox-modal");
    if (!lightboxModal) {
      lightboxModal = document.createElement("div");
      lightboxModal.id = "lightbox-modal";
      lightboxModal.className =
        "fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/85 p-4 backdrop-blur-sm transition-all duration-200 select-none";
      lightboxModal.innerHTML = `
        <button id="lightbox-close" type="button" aria-label="閉じる" class="absolute top-4 right-4 z-10 p-2 text-white/80 hover:text-white focus:outline-none text-2xl font-bold rounded-full bg-black/40 hover:bg-black/70 w-10 h-10 flex items-center justify-center transition-colors">
          &times;
        </button>
        <div class="relative max-w-full max-h-full flex items-center justify-center">
          <img id="lightbox-img" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E" alt="" class="max-h-[90vh] max-w-[90vw] object-contain rounded-lg shadow-2xl transition-transform duration-200 cursor-zoom-out" />
        </div>
      `;
      document.body.appendChild(lightboxModal);

      const closeLightbox = () => {
        lightboxModal.classList.add("hidden");
        document.body.style.overflow = "";
        const modalImg = lightboxModal.querySelector("#lightbox-img");
        if (modalImg) modalImg.src = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E";
      };

      const closeBtn = lightboxModal.querySelector("#lightbox-close");
      closeBtn?.addEventListener("click", closeLightbox);
      lightboxModal.addEventListener("click", (e) => {
        if (e.target === lightboxModal || e.target.id === "lightbox-img" || e.target.id === "lightbox-close") {
          closeLightbox();
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !lightboxModal.classList.contains("hidden")) {
          closeLightbox();
        }
      });
    }

    const article = document.getElementById("article");
    if (!article) return;

    const images = article.querySelectorAll("img");
    for (const img of images) {
      if (img.classList.contains("inline-image") || img.classList.contains("status-icon")) continue;
      if (img.dataset.lightboxAttached) continue;
      img.dataset.lightboxAttached = "true";
      img.classList.add("cursor-zoom-in");

      img.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const fullSrc = img.getAttribute("data-full-src") || img.src;
        const modalImg = lightboxModal.querySelector("#lightbox-img");
        if (modalImg) {
          modalImg.src = fullSrc;
          modalImg.alt = img.alt || "";
        }
        lightboxModal.classList.remove("hidden");
        document.body.style.overflow = "hidden";
      });
    }
  }

  // Initialize features
  setupProgressBar();
  addHeadingLinks();
  attachCopyButtons();
  setupLightbox();

  // Handle scroll reset after transition
  document.addEventListener("astro:after-swap", () => {
    window.scrollTo({ left: 0, top: 0, behavior: "instant" });
  }, { once: true });
</script>

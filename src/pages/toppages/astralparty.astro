---
import CategoryPage from "@/components/CategoryPage.astro";

export const metadata = {
  id: "astralparty",
  title: "アストラルパーティー",
  description: "アストラルパーティーの強化チップ一覧や仕様解説、各種攻略情報をまとめています。",
  showOnIndex: true,
  order: 2,
};

const groupOrder = ["初心者向け","仕様解説", "攻略情報", "その他"];
const groupDescriptions = {
  "初心者向け": "アストラルパーティーを始めたけど何をしたらいいかが分からない初心者におすすめの記事です。",
  "仕様解説": "アストラルパーティーのゲームシステムや、強化チップなどの仕様解説です。",
  "攻略情報": "キャラクターの立ち回りやマップごとの攻略情報です。",
  "その他": "その他のアストラルパーティー関連記事です。",

};
---

<CategoryPage
  categoryId="astralparty"
  title="アストラルパーティー"
  description="アストラルパーティーの強化チップ一覧や仕様解説、各種攻略情報をまとめています。"

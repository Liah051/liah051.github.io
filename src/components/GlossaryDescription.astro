---
import InlineImage from "./InlineImage.astro";
import { marked } from "marked";

interface Props {
  text: string;
}

const { text } = Astro.props;

// 属性をパースしてオブジェクトにするヘルパー
const parseAttributes = (attrStr: string) => {
  const attrs: Record<string, string> = {};
  const regex = /([\w-]+)="([^"]*)"/g;
  let match;
  while ((match = regex.exec(attrStr)) !== null) {
    attrs[match[1]] = match[2];
  }
  return attrs;
};

// <InlineImage .../> パターンを解析して、テキストとコンポーネントに分割する
// name="..." 以外（item, rarity等）も取得できるように正規表現を拡張
const INLINE_IMAGE_REGEX = /<InlineImage\s+([^>]+)\s*\/>/g;

type Segment =
  | { type: "text"; html: string }
  | { type: "icon"; props: Record<string, string> };

const segments: Segment[] = [];
let lastIndex = 0;
let match: RegExpExecArray | null;

while ((match = INLINE_IMAGE_REGEX.exec(text)) !== null) {
  // マッチ前のテキスト部分を追加
  if (match.index > lastIndex) {
    const rawText = text.slice(lastIndex, match.index);
    const html = await marked.parseInline(rawText);
    segments.push({ type: "text", html });
  }
  // InlineImage の属性をパースして追加
  segments.push({ type: "icon", props: parseAttributes(match[1]) });
  lastIndex = match.index + match[0].length;
}

// 残りのテキストを追加
if (lastIndex < text.length) {
  const rawText = text.slice(lastIndex);
  const html = await marked.parseInline(rawText);
  segments.push({ type: "text", html });
}
---

{
  segments.map(seg =>
    seg.type === "icon" ? (
      <InlineImage {...seg.props} />
    ) : (
      <Fragment set:html={seg.html} />
    )
  )
}

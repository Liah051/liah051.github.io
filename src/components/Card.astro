---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";
import type { ImageMetadata } from "astro";
import SmartImage from "./SmartImage.astro";
import { SITE } from "@/config";
import { cleanTitle } from "@/utils/cleanTitle";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, thumbnail, ...props } = data;

// Handled by SmartImage component

// Fallback image if no thumbnail
const getPostThumbnail = () => {
  const initOgImage = data.ogImage;
  if (initOgImage) {
    return initOgImage;
  }

  if (SITE.dynamicOgImage) {
    return `${getPath(id, filePath)}/index.png`;
  }

  return SITE.ogImage ? `/${SITE.ogImage}` : "/og.png";
};
---

<li class="my-6">
  <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 items-start group">
    <a href={getPath(id, filePath)} class="shrink-0 w-full sm:w-48 aspect-[1200/630] overflow-hidden rounded-lg bg-muted block">
      <SmartImage 
        image={thumbnail || getPostThumbnail()} 
        alt={cleanTitle(title, data.category_id)} 
        size={"100%"}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105 bg-muted" 
      />
    </a>
    
    <div class="flex-1 min-w-0 pt-1">
      <a
        href={getPath(id, filePath)}
        class="inline-block text-lg font-bold text-accent decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline focus-visible:underline-offset-0"
      >
        <Heading
          style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
        >
          {cleanTitle(title, data.category_id)}
        </Heading>
      </a>
      <Datetime {...props} class="mt-1" />
      <p class="mt-2 text-sm line-clamp-3 opacity-90 leading-relaxed text-foreground">{description}</p>
    </div>
  </div>
</li>

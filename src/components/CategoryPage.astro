---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SmartImage from "@/components/SmartImage.astro";
import { getCollection } from "astro:content";
import { SIDEBAR_MAP, DefaultSidebar } from "@/components/sidebars";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";
import { cleanTitle } from "@/utils/cleanTitle";

interface GroupSection {
  type: "group";
  name: string;
  description?: string;
}

interface CustomGroupSection {
  type: "custom-group";
  name: string;
  posts: string[];
  description?: string;
}

interface PostsGridSection {
  type: "posts-grid";
  name?: string;
  posts: string[];
  description?: string;
}

export type PageSection = GroupSection | CustomGroupSection | PostsGridSection;

export interface Props {
  categoryId: string;
  title: string;
  description?: string;
  sections?: PageSection[];
  // Fallbacks for Simple Mode
  groupOrder?: string[];
  groupDescriptions?: Record<string, string>;
}

const {
  categoryId,
  title,
  description,
  sections,
  groupOrder = [],
  groupDescriptions = {}
} = Astro.props;

// Fetch all posts except drafts
const allPosts = await getCollection("blog", ({ data }) => data.draft !== true);

// Helper to resolve post by ID (supports extensions/basenames)
const resolvePost = (postId: string) => {
  return allPosts.find(
    p => p.id === postId || p.id.replace(/\.(md|mdx)$/, '') === postId.replace(/\.(md|mdx)$/, '')
  );
};

// Populate the sections data
let resolvedSections: Array<{
  name?: string;
  description?: string;
  posts: typeof allPosts;
}> = [];

if (sections && sections.length > 0) {
  // Flexible Mode: Render sections in specified manual layout
  resolvedSections = sections.map(section => {
    if (section.type === "group") {
      // Auto-grouped category posts
      const groupPosts = allPosts.filter(
        post => post.data.category_id === categoryId && (post.data.group || "その他") === section.name
      );
      // Sort inside group by order
      groupPosts.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
      
      return {
        name: section.name,
        description: section.description || groupDescriptions[section.name],
        posts: groupPosts
      };
    } else if (section.type === "custom-group" || section.type === "posts-grid") {
      // Manual list of mixed posts
      const resolvedPosts = section.posts
        .map(resolvePost)
        .filter((p): p is NonNullable<typeof p> => p !== undefined);
      
      return {
        name: section.name,
        description: section.description,
        posts: resolvedPosts
      };
    }
    return { posts: [] };
  }).filter(s => s.posts.length > 0);
} else {
  // Simple Mode (backward compatible): Auto-detect all groups under this category
  const categoryPosts = allPosts.filter(post => post.data.category_id === categoryId);
  const grouped = categoryPosts.reduce((acc, post) => {
    const groupName = post.data.group || "その他";
    const isDefined = groupOrder.includes(groupName) || Object.prototype.hasOwnProperty.call(groupDescriptions, groupName);
    if (!isDefined) return acc;

    if (!acc[groupName]) acc[groupName] = [];
    acc[groupName].push(post);
    return acc;
  }, {} as Record<string, typeof allPosts>);

  const sortedGroupNames = Object.keys(grouped).sort((a, b) => {
    const indexA = groupOrder.indexOf(a);
    const indexB = groupOrder.indexOf(b);
    if (indexA === -1 && indexB === -1) return a.localeCompare(b);
    if (indexA === -1) return 1;
    if (indexB === -1) return -1;
    return indexA - indexB;
  });

  resolvedSections = sortedGroupNames.map(name => {
    const groupPosts = grouped[name];
    groupPosts.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
    return {
      name,
      description: groupDescriptions[name],
      posts: groupPosts
    };
  });
}

// Resolve sidebar dynamically
const SidebarComponent = SIDEBAR_MAP[categoryId] || DefaultSidebar;

const getPostThumbnail = (post: typeof allPosts[0]) => {
  const initOgImage = post.data.ogImage;
  if (initOgImage) {
    return initOgImage;
  }

  if (SITE.dynamicOgImage) {
    return `${getPath(post.id, post.filePath)}/index.png`;
  }

  return SITE.ogImage ? `/${SITE.ogImage}` : "/og.png";
};
const ogImage = `/toppages/${categoryId}.png`;
---

<Layout title={`${title} | カテゴリー`} ogImage={ogImage}>
  <Header />
  <main class="mx-auto max-w-6xl px-4 py-8 flex flex-col md:flex-row gap-8">
    <div class="content-area w-full md:w-3/4">
      <h1 class="text-3xl font-bold mb-4">{title}</h1>
      {description && <p class="mb-10 opacity-80 leading-relaxed">{description}</p>}

      <div class="space-y-12">
        {resolvedSections.map(section => (
          <section class="group-section">
            {section.name && <h2 class="text-2xl font-semibold mb-3 border-b border-skin-line pb-2">{section.name}</h2>}
            {section.description && <p class="mb-6 opacity-80">{section.description}</p>}
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {section.posts.map(post => (
                <a href={`/posts/${post.id}/`} class="flex items-start gap-4 p-4 border border-skin-line rounded-lg hover:border-skin-accent transition">
                  <div class="image-container w-32 aspect-[1200/630] shrink-0 bg-skin-card rounded overflow-hidden flex items-center justify-center">
                    <SmartImage image={post.data.thumbnail || getPostThumbnail(post)} alt={cleanTitle(post.data.title, post.data.category_id)} class="w-full h-full object-cover" size={128} />
                  </div>
                  <div class="info-container flex-1">
                    <h3 class="font-bold text-lg leading-tight mb-2 hover:text-skin-accent">{cleanTitle(post.data.title, post.data.category_id)}</h3>
                    <p class="text-sm opacity-70 line-clamp-2">{post.data.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
    
    <div class="sidebar-area w-full md:w-1/4">
      <SidebarComponent />
    </div>
  </main>
  <Footer />
</Layout>

---
import type { ImageMetadata } from "astro";
import AspaChip from "./ASPA/AspaChip.astro";

interface Props {
  name?: string;
  item?: string;
  rarity?: string;
  alt?: string;
}

const { name, item, rarity, alt = "" } = Astro.props;

let image;
if (name && !item) {
  // ★ 修正ポイント：検索対象を /status/ から /astralparty/ 全体に広げ、サブフォルダも探すようにする
  const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/astralparty/**/*.{png,webp}"
  );

  // 指定された名前に一致する画像パスを検索
  let imagePath = Object.keys(images).find(path => {
    const fileNameWithExt = path.split("/").pop(); // 例: "atk.png"
    const fileName = fileNameWithExt?.split(".").slice(0, -1).join("."); // 例: "atk"

    // ファイル名が name と一致するかチェック
    return fileName === name;
  });

  if (!imagePath) {
    // エラーメッセージも少し汎用的に修正
    throw new Error(
      `Icon "${name}" not found in /src/assets/images/astralparty/`
    );
  }

  const imageModule = await images[imagePath]();
  image = imageModule.default;
}
---

{
  item ? (
    <span class="status-icon-chip">
      <AspaChip item={item} rarity={rarity} size="1.2em" />
    </span>
  ) : (
    image && <img src={image.src} alt={alt || name} class="status-icon" loading="lazy" decoding="async" width={image.width} height={image.height} />
  )
}

<style>
  .status-icon,
  .status-icon-chip {
    display: inline-block;
    width: 1.2em;
    height: 1.2em;
    vertical-align: 0.1em;
    margin: 0 !important;
  }

  .status-icon {
    object-fit: contain;
    border: none !important;
    box-shadow: none !important;
    background: transparent !important;
  }

  .status-icon-chip {
    line-height: 0;
  }
</style>

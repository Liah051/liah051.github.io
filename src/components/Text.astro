---
// src/components/Text.astro
interface Props {
  color?: string;
  size?: string | number;
}

const { color, size } = Astro.props;

// Process size to handle both number and string with units
let fontSize: string | undefined = undefined;
if (typeof size === 'number') {
  fontSize = size > 4 ? `${size}px` : `${size}rem`;
} else if (typeof size === 'string') {
  if (/^\d+(\.\d+)?$/.test(size.trim())) {
    const num = parseFloat(size.trim());
    fontSize = num > 4 ? `${num}px` : `${num}rem`;
  } else {
    fontSize = size;
  }
}

// Prepare inline styles
const style: Record<string, string> = {};
if (color) {
  style['--custom-color'] = color;
  style.color = 'var(--custom-color, inherit)';
}
if (fontSize) {
  style.fontSize = fontSize;
}
---

<span class="mdx-text" style={style}>
  <slot />
</span>

<style>
  .mdx-text {
    display: inline;
    color: var(--custom-color, inherit);
  }

  /* 
    Automatically adjust text color brightness and saturation in dark mode.
    By using color-mix and oklch on the text color instead of CSS filter, 
    child elements like images and icons (e.g. <InlineImage>) remain completely unaffected.
  */
  :global(html[data-theme="dark"]) .mdx-text,
  :global([data-theme="dark"]) .mdx-text,
  :global(.dark) .mdx-text {
    /* Fallback: Mix custom color with white (40%) to brighten it */
    color: color-mix(in srgb, var(--custom-color), #fff 40%) !important;
    
    /* Modern relative color syntax: Brightens (lightness * 1.4) and saturates (chroma * 1.2) */
    color: oklch(from var(--custom-color) calc(l * 1.4) calc(c * 1.2) h) !important;
  }
</style>

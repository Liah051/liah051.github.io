---

---

<section
  class="group relative mb-8 w-full overflow-hidden rounded-3xl border border-slate-800 bg-slate-950 p-8 shadow-2xl sm:p-12"
>
  <!-- Background Decor: Grid -->
  <div
    class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] mask-[radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] bg-size-[24px_24px]"
  >
  </div>

  <!-- Background Decor: Glow effects -->
  <div
    class="absolute -top-32 -right-32 h-128 w-lg rounded-full bg-accent/15 opacity-50 mix-blend-screen blur-3xl transition-transform duration-1000 group-hover:scale-110"
  >
  </div>
  <div
    class="absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-blue-500/15 opacity-40 mix-blend-screen blur-3xl transition-transform duration-1000 group-hover:scale-110"
  >
  </div>

  <div class="relative z-10 flex flex-col items-center text-center">
    <!-- Header row with Name -->
    <h1
      class="mb-4 bg-linear-to-br from-white via-slate-200 to-slate-500 bg-clip-text text-6xl font-black tracking-tighter text-transparent drop-shadow-[0_2px_10px_rgba(255,255,255,0.1)] select-none sm:text-8xl"
    >
      Liah
    </h1>

    <!-- Badge / Subtitle -->
    <div
      class="mb-6 inline-flex cursor-default items-center rounded-full border border-slate-700/60 bg-slate-800/40 px-3 py-1 text-sm font-medium text-slate-300 backdrop-blur-sm"
    >
      <span
        class="mr-2 flex h-2 w-2 animate-pulse rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]"
      ></span>
      Engineering Student & Developer
    </div>

    <!-- Description -->
    <p
      class="max-w-xl text-base leading-relaxed font-medium text-slate-400 sm:text-lg"
    >
      情報系学生の技術ブログ兼ポートフォリオ。<br class="hidden sm:block" />
      <span
        class="font-semibold text-slate-200 drop-shadow-[0_0_8px_rgba(255,255,255,0.3)]"
        >C言語</span
      >や<span
        class="font-semibold text-slate-200 drop-shadow-[0_0_8px_rgba(255,255,255,0.3)]"
        >JavaScript</span
      >を中心に、技術の探求と日々の学びを記録しています。
    </p>

    <!-- Call to Actions -->
    <div
      class="mt-8 flex w-full flex-col items-center gap-4 sm:w-auto sm:flex-row"
    >
      <a
        href="/posts"
        class="group/btn relative inline-flex w-full items-center justify-center overflow-hidden rounded-xl bg-slate-100 px-6 py-3 text-sm font-bold text-slate-950 shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:bg-white hover:shadow-[0_0_20px_rgba(255,255,255,0.6)] sm:w-auto"
      >
        <span class="relative z-10 flex items-center gap-2">
          Read Articles
          <svg
            class="h-4 w-4 transition-transform duration-300 group-hover/btn:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </span>
      </a>

      <a
        href="https://github.com/liah051"
        target="_blank"
        rel="noopener noreferrer"
        class="group/btn2 relative inline-flex w-full items-center justify-center overflow-hidden rounded-xl border border-slate-700 bg-slate-800/80 px-6 py-3 text-sm font-bold text-slate-200 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-slate-500 hover:bg-slate-700 hover:text-white hover:shadow-[0_0_20px_rgba(255,255,255,0.1)] sm:w-auto"
      >
        <svg
          class="mr-2 h-5 w-5 opacity-80 transition-opacity group-hover/btn2:opacity-100"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            clip-rule="evenodd"></path>
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</section>

---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import IconReload from "@/assets/icons/IconReload.svg";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime?: string | Date;
  pubDate?: string | Date;
  date?: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  updatedDate?: string | Date | null;
  updated?: string | Date | null;
};

const {
  pubDatetime,
  pubDate,
  date,
  modDatetime,
  updatedDate,
  updated,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const rawPubDate = pubDatetime || pubDate || date;
const rawModDate = modDatetime || updatedDate || updated;

/* ========== Formatted Datetime ========== */
const pubDateObj = rawPubDate ? dayjs(rawPubDate).tz(postTimezone || SITE.timezone) : null;
const modDateObj = rawModDate ? dayjs(rawModDate).tz(postTimezone || SITE.timezone) : null;

const pubFormatted = pubDateObj && pubDateObj.isValid() ? pubDateObj.format("YYYY年M月D日") : "";
const modFormatted = modDateObj && modDateObj.isValid() ? modDateObj.format("YYYY年M月D日") : "";

const isModified = Boolean(
  rawModDate &&
    modDateObj &&
    modDateObj.isValid() &&
    pubDateObj &&
    pubDateObj.isValid() &&
    modFormatted !== pubFormatted &&
    modDateObj.valueOf() > pubDateObj.valueOf()
);
---

<div class:list={["flex flex-wrap items-center opacity-80", className]}>
  <span class="inline-flex items-center gap-x-1.5">
    <IconCalendar
      class:list={[
        "inline-block size-6 min-w-5.5",
        { "scale-90": size === "sm" },
      ]}
    />
    {
      pubDateObj && pubDateObj.isValid() && (
        <time
          class:list={["text-sm", { "sm:text-base": size === "lg" }]}
          datetime={pubDateObj.toISOString()}
        >
          {pubFormatted}
        </time>
      )
    }
  </span>
  {
    isModified && modDateObj && (
      <span class="inline-flex items-center">
        <span
          class="mx-2 text-foreground/40 font-normal select-none"
          aria-hidden="true"
        >
          /
        </span>
        <span class="inline-flex items-center gap-x-1.5">
          <IconReload
            class:list={[
              "inline-block size-6 min-w-5.5",
              { "scale-90": size === "sm" },
            ]}
          />
          <time
            class:list={["text-sm", { "sm:text-base": size === "lg" }]}
            datetime={modDateObj.toISOString()}
          >
            {modFormatted}
          </time>
        </span>
      </span>
    )
  }
</div>


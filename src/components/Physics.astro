---
// src/components/Physics.astro
import SmartPhysicsSvg from './SmartPhysicsSvg.astro';

interface Props {
  name: string; // 例: "力学/physics_01"
}

const { name } = Astro.props;

/**
 * Viteの機能を使用して、物理図解ディレクトリ内の全てのSVGを「生文字列(?raw)」として一括インポートします。
 * これにより、個別のMDXファイルでimport文を書く必要がなくなります。
 */
const allSvgs = import.meta.glob('../assets/images/physics/**/*.svg', { 
  query: '?raw', 
  import: 'default', 
  eager: true 
});

// ファイルシステム上の絶対的なパスではなく、globのキーに合わせた相対パスを生成します
const targetPath = `../assets/images/physics/${name}.svg`;
const svgCode = allSvgs[targetPath] as string;
---

{svgCode ? (
  <SmartPhysicsSvg svgCode={svgCode} />
) : (
  <div style="border: 2px solid red; padding: 10px; color: red;">
    <strong>Error: SVG not found</strong><br />
    Name: {name}<br />
    Path: {targetPath}
  </div>
)}
